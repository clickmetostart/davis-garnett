{
  "manifest_version": 3,
  "name": "D&G Dash Web Clipper",
  "version": "1.0",
  "description": "Extracts real estate listings (Commercial and Residential) and sends them to the ClickMe CRM.",
  "permissions": [
    "activeTab",
    "scripting"
  ],
  "host_permissions": [
    "http://localhost:3000/*",
    "https://*.zillow.com/*",
    "https://*.redfin.com/*",
    "https://*.loopnet.com/*",
    "https://*.crexi.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://*.zillow.com/*",
        "https://*.redfin.com/*",
        "https://*.loopnet.com/*",
        "https://*.crexi.com/*"
      ],
      "js": ["content.js"],
      "css": ["content.css"]
    }
  ],
  "action": {
    "default_title": "Import Listing to CRM"
  }
}
