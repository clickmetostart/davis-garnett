<!DOCTYPE html>
<html>
<head>
  <meta charset="utf-8">
  <title>Knowledge Hub_[slug] - Site Content</title>
  <style>
    body {
      font-family: 'Calibri', 'Arial', sans-serif;
      line-height: 1.6;
      color: #333333;
      margin: 40px;
      max-width: 800px;
    }
    h1 {
      color: #0b142b;
      font-size: 26pt;
      border-bottom: 3px solid #4fd1c5;
      padding-bottom: 12px;
      margin-bottom: 25px;
      font-family: 'Georgia', serif;
    }
    h2 {
      color: #1a365d;
      font-size: 18pt;
      margin-top: 35px;
      margin-bottom: 15px;
      border-bottom: 1px solid #e2e8f0;
      padding-bottom: 6px;
    }
    h3 {
      color: #2b6cb0;
      font-size: 14pt;
      margin-top: 25px;
      margin-bottom: 10px;
    }
    p {
      font-size: 11pt;
      margin-bottom: 15px;
      text-align: justify;
    }
    ul, ol {
      margin-bottom: 20px;
      padding-left: 25px;
    }
    li {
      font-size: 11pt;
      margin-bottom: 8px;
    }
    .meta-box {
      background-color: #f7fafc;
      border: 1px solid #e2e8f0;
      padding: 15px 20px;
      margin-bottom: 30px;
      border-radius: 8px;
    }
    .meta-title {
      font-weight: bold;
      color: #718096;
      font-size: 9pt;
      text-transform: uppercase;
      letter-spacing: 1px;
      margin-bottom: 5px;
    }
    .meta-value {
      font-size: 10.5pt;
      color: #2d3748;
      margin-bottom: 10px;
    }
    .meta-value:last-child {
      margin-bottom: 0;
    }
    .hero-box {
      background-color: #ebf8ff;
      border-left: 6px solid #3182ce;
      padding: 20px;
      margin-bottom: 30px;
      border-radius: 0 8px 8px 0;
    }
    .hero-title {
      font-size: 16pt;
      font-weight: bold;
      color: #2b6cb0;
      margin-bottom: 10px;
    }
    .hero-sub {
      font-size: 11pt;
      color: #4a5568;
      font-style: italic;
    }
    .list-block {
      background-color: #f7fafc;
      border: 1px solid #edf2f7;
      padding: 15px 20px;
      margin-bottom: 25px;
      border-radius: 8px;
    }
    .list-title {
      font-weight: bold;
      color: #2d3748;
      font-size: 12pt;
      margin-bottom: 10px;
    }
    .faq-card {
      background-color: #fffaf0;
      border: 1px solid #feebc8;
      border-left: 4px solid #dd6b20;
      padding: 15px;
      margin-bottom: 15px;
      border-radius: 4px;
    }
    .faq-q {
      font-weight: bold;
      font-size: 11pt;
      color: #7b341e;
      margin-bottom: 6px;
    }
    .faq-a {
      font-size: 11pt;
      color: #4a5568;
    }
  </style>
</head>
<body>
  <h1>Knowledge Hub_[slug] - Editable Website Content</h1>
  
  <div class="meta-box">
    <div class="meta-title">Page Metadata (For SEO)</div>
    <div class="meta-value"><strong>SEO Title:</strong> Post Not Found | MadCity Home Loans</div>
    <div class="meta-value"><strong>Meta Description:</strong> N/A</div>
  </div>

  <h2>Hero Banner Section</h2>
  <div class="hero-box">
    
    <div class="hero-title">{post.title}</div>
    <div class="hero-sub"></div>
  </div>
<h2>Body & Copy Content</h2><h3>Ready to take the next step?</h3><p>Get personalized advice from Rob Miller and the MadCity Home Loans team.</p>
</body>
</html>